use std::cli;
use kinglet;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(kinglet_respond(100.0, 1.0, 90.0, 200.0), [206, 90, 10, 100]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(kinglet_respond(100.0, 2.0, 12.0, -1.0), [206, 88, 12, 100]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(kinglet_respond(0.0, 1.0, 0.0, -1.0), [416, 0, 0, 0]) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(kinglet_respond(2.0, 0.0, 0.0, -1.0), [200, 0, 2, 2]) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(kinglet_respond(4.0, 4.0, 0.0, -1.0), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(kinglet_respond(infinity, 1.0, 90.0, 200.0), []) { stderr_line("case 6 failed"); process_exit(1); }
    if !matches(kinglet_respond(100.0, infinity, 90.0, 200.0), []) { stderr_line("case 7 failed"); process_exit(1); }
    if !matches(kinglet_respond(100.0, 1.0, infinity, 200.0), []) { stderr_line("case 8 failed"); process_exit(1); }
    if !matches(kinglet_respond(100.0, 1.0, 90.0, infinity), []) { stderr_line("case 9 failed"); process_exit(1); }
    println!("passed");
}
