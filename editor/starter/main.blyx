use vendor::kinglet::kinglet;

fn main() {
    let size = 100.0;
    let mode = 1.0;
    let first = 90.0;
    let last = 200.0;
    let result = kinglet_respond(size, mode, first, last);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
