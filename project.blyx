use std::cli;
use console;
use kinglet;

fn main() {
    let argv = cli_args();
    let count = args_len(argv);
    if count == 1 && args_at(argv, 0) == "--help" {
        println!("Plan a full or single-range HTTP response against a known representation size.");
        println!("Usage: kinglet size mode first last");
        println!("Vector arguments are comma-separated; use [] for an empty vector.");
        return;
    }
    let mut result = [];
    if count == 0 {
        result = kinglet_respond(100.0, 1.0, 90.0, 200.0);
    } else {
        if count != 4 { stderr_line("Wrong argument count. Use --help."); process_exit(2); }
        let size = console_value(args_at(argv, 0));
        let mode = console_value(args_at(argv, 1));
        let first = console_value(args_at(argv, 2));
        let last = console_value(args_at(argv, 3));
        result = kinglet_respond(size, mode, first, last);
    }
    if len(result) == 0 { stderr_line("Invalid input for Kinglet. See the package input contract."); process_exit(1); }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
